{
  "id": "dotnet-project",
  "summary": "A .NET SDK project: one or more *.csproj anywhere in the tree, with any solution files.",
  "evidence": [
    { "kind": "glob_any", "pattern": "**/*.csproj" },
    { "kind": "glob_any", "pattern": "**/*.sln", "optional": true }
  ],
  "emits": {
    "stack.dotnet": true,
    "stack.dotnet.projects": "$1",
    "stack.dotnet.solutions": "$2"
  }
}
