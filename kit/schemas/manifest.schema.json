{
  "$id": "manifest",
  "title": "Kit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kit", "classes", "planes", "capabilities", "detectors", "schemas"],
  "properties": {
    "schema_version": { "type": "integer" },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["vendor", "binding", "projection", "ephemeral"] }
    },
    "planes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "root"],
        "properties": {
          "class": { "type": "string", "enum": ["vendor", "binding", "projection", "ephemeral"] },
          "root": { "type": "string", "minLength": 1 }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "declaration"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "declaration": { "type": "string", "minLength": 1 },
          "never_disabled": { "type": "boolean" }
        }
      }
    },
    "detectors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "schemas": { "type": "object" }
  }
}
