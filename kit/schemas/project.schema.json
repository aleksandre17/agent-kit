{
  "$id": "project",
  "title": "Host project declaration (BINDING)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "kit_version", "capabilities", "drafted_at"],
  "properties": {
    "schema_version": { "type": "integer" },
    "status": { "type": "string", "enum": ["draft", "accepted"] },
    "kit_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "capabilities": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unavailable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "drafted_at": { "type": "string", "minLength": 1 },
    "signed_by": { "type": "string", "minLength": 1 },
    "signed_at": { "type": "string", "minLength": 1 },
    "stances": {
      "description": "The host's answer, gate by gate, to how hard each gate holds it (ADR-006). A row names a gate id and one stance of the kit's stance vocabulary, with who declared it and when. Maturation is this row being restated -- by a named human, on a date -- never a threshold the machine crossed on its own. A gate with no row stands in the stance its capability ships, else the vocabulary's `unanswered` stance.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "stance", "by", "at"],
        "properties": {
          "gate": { "type": "string", "minLength": 1 },
          "stance": { "type": "string", "minLength": 1 },
          "by": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "minLength": 1 },
          "because": { "type": "string" }
        }
      }
    }
  }
}
