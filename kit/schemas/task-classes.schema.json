{
  "$id": "task-classes",
  "title": "TASK CLASSES -- the classes of work a route table routes, and who carries each out by default",
  "description": "Every token serves the result: what a script or a verb can do deterministically is done by it (zero tokens); a model is spent only where judgement is needed. A class names its default actor; a host's route cells choose the actual one, the model and the effort, and escalate only on a declared signal (ADR-024).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "says",
          "actor"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "says": {
            "type": "string",
            "minLength": 1
          },
          "actor": {
            "type": "string",
            "enum": [
              "script",
              "model",
              "human"
            ]
          }
        }
      }
    },
    "procedure": {
      "description": "The decision procedure that assigns a class, one question at a time; the first answer that decides, decides.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asks",
          "decides"
        ],
        "properties": {
          "asks": {
            "type": "string",
            "minLength": 1
          },
          "decides": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "preconditions": {
      "description": "What must ALL hold before work is classed mechanical (automated): most-but-not-all is assisted.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "says",
          "falsifier"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "says": {
            "type": "string",
            "minLength": 1
          },
          "falsifier": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
