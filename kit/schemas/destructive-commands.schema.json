{
  "$id": "destructive-commands",
  "title": "DESTRUCTIVE COMMANDS -- commands that discard work across the tree, given a recovery point first",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commands"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "matches",
          "because"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "matches": {
            "type": "string",
            "minLength": 1
          },
          "because": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
