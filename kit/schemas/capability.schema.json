{
  "$id": "capability",
  "title": "Capability declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "requires", "provides", "conflicts", "installs", "declares", "gates"],
  "properties": {
    "schema_version": { "type": "integer" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "summary": { "type": "string" },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id"],
        "properties": {
          "kind": { "type": "string", "enum": ["capability", "fact"] },
          "id": { "type": "string", "minLength": 1 },
          "equals": {}
        }
      }
    },
    "provides": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "declares": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "detectors": { "type": "array", "items": { "type": "string" } },
        "schemas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "installs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "class", "target"],
        "properties": {
          "mode": { "type": "string", "minLength": 1 },
          "class": { "type": "string", "enum": ["vendor", "binding", "projection", "ephemeral"] },
          "target": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "validates": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "params": { "type": "object" }
        }
      }
    }
  }
}
