{
  "schema_version": 1,
  "id": "enforcement",
  "version": "0.1.0",
  "summary": "Declares the ENFORCEMENT LINE: a host's own edit gates, judged at the moment an edit is made, from whichever runtime the host serves. The host declares the gates -- which paths, which introduced text, why, and what instead -- and the kit ships only their grammar and ONE judge (the `judge` verb), vendored in the pinned kit and run by the hook a runtime adapter serves. The judge holds no policy and knows no product: how a product hands a hook its edit, and how it is told no, is declared by that product's surface (ADR-013/014). Every gate is calibrated before it is believed; `check` fails an uncalibrated one, and the judge names it as unjudged rather than refusing on its word.",
  "requires": [
    {
      "kind": "capability",
      "id": "governance"
    }
  ],
  "provides": [
    "enforcement"
  ],
  "conflicts": [],
  "declares": {
    "schemas": [
      "edit-gate",
      "destructive-commands",
      "spawn-packets",
      "message-rules",
      "known-violations"
    ]
  },
  "installs": [
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/enforcement/edit-gates.json",
      "source": "capabilities/enforcement/payload/edit-gates-local.json",
      "validates": "edit-gate",
      "reads_as": "host_edit_gates",
      "points": [
        {
          "id": "edit-gates",
          "purpose": "this host's calibrated edit gates",
          "cardinality": "one",
          "merges_into": "every edit and commit judgement"
        }
      ]
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/enforcement/known-violations.json",
      "source": "capabilities/enforcement/payload/known-violations-local.json",
      "validates": "known-violations",
      "reads_as": "host_known_violations",
      "points": [
        {
          "id": "known-violations",
          "purpose": "violations already in this tree, acknowledged with their tracking",
          "cardinality": "one",
          "merges_into": "the whole-tree audit (`audit`, FF-TREE-AUDIT)"
        }
      ]
    }
  ],
  "gates": [
    {
      "id": "FF-EDIT-GATE",
      "kind": "edit-gates-calibrated",
      "params": {
        "sources": {
          "validates": "edit-gate"
        }
      }
    },
    {
      "id": "FF-MESSAGE-RULE",
      "kind": "message-rules-calibrated",
      "params": {
        "sources": {
          "validates": "message-rules"
        }
      }
    },
    {
      "id": "FF-TREE-AUDIT",
      "kind": "tree-audited",
      "params": {},
      "stance": {
        "ships": "observe"
      }
    }
  ]
}
