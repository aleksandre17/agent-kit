{
  "schema_version": 1,
  "id": "delivery",
  "version": "0.2.0",
  "summary": "Declares the task lifecycle as data: cards are BINDING and carry exactly one state, the board is a PROJECTION of them, the owner's acceptance is a declared door no machine may open, and capacity and staleness are limits the host declares. It requires no provision, and the emptiness is deliberate: everything it reads -- its lifecycle, its policy, its cards -- it declares itself, and a capability that listed a dependency it never consumes would be promising a coupling nobody keeps. That the kit cannot stand without governance is the KIT's statement, made once on the manifest entry as never_disabled; restating it here would be a second home for it.",
  "doctrine": "capabilities/delivery/payload/delivery.md",
  "requires": [],
  "provides": ["delivery"],
  "conflicts": [],
  "declares": {
    "schemas": ["lifecycle", "card", "delivery-policy", "lesson", "work-classes", "delivery-areas", "review-record"]
  },
  "documents": [
    {
      "id": "lifecycle",
      "source": "capabilities/delivery/lifecycle.json",
      "validates": "lifecycle"
    },
    {
      "id": "lesson",
      "source": "capabilities/delivery/lesson.json",
      "validates": "lesson"
    },
    {
      "id": "work_classes",
      "source": "capabilities/delivery/work-classes.json",
      "validates": "work-classes"
    }
  ],
  "governs": {
    "collection": "cards",
    "state_field": "state",
    "lifecycle": "lifecycle",
    "policy": "policy",
    "board": "columns",
    "criteria": "criteria",
    "lesson": "lesson"
  },
  "installs": [
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/delivery/policy.json",
      "source": "capabilities/delivery/payload/policy.json",
      "validates": "delivery-policy",
      "reads_as": "policy"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/delivery/areas.json",
      "source": "capabilities/delivery/payload/areas.json",
      "validates": "delivery-areas",
      "reads_as": "areas"
    },
    {
      "mode": "space",
      "class": "binding",
      "target": "docs/work/cards/",
      "validates": "card",
      "reads_as": "cards"
    },
    {
      "mode": "space",
      "class": "binding",
      "target": "docs/work/evidence/"
    },
    {
      "mode": "space",
      "class": "binding",
      "target": "docs/work/archive/",
      "validates": "card"
    },
    {
      "mode": "projection",
      "class": "projection",
      "target": "docs/work/BOARD.md",
      "source": "capabilities/delivery/payload/BOARD.md.mustache"
    }
  ],
  "relocations": [
    {
      "from": ".agents/project/delivery/cards/",
      "to": "docs/work/cards/",
      "decision": "ADR-021 decision 3"
    },
    {
      "from": ".agents/generated/delivery/BOARD.md",
      "to": "docs/work/BOARD.md",
      "decision": "ADR-021 decision 3"
    }
  ],
  "gates": [
    {
      "id": "FF-DELIVERY-WIP",
      "kind": "capacity-within-limit",
      "params": {}
    },
    {
      "id": "FF-DELIVERY-AGE",
      "kind": "state-age-within-limit",
      "params": {}
    },
    {
      "id": "FF-DELIVERY-LINEAGE",
      "kind": "lineage-resolves",
      "params": {}
    },
    {
      "id": "FF-WORK-CLASSES",
      "kind": "work-classes-held",
      "params": {}
    },
    {
      "id": "FF-WORK-DEFERRALS",
      "kind": "deferrals-held",
      "params": {}
    },
    {
      "id": "FF-WORK-ORDER",
      "kind": "order-held",
      "params": {}
    },
    {
      "id": "FF-WORK-SIGNED",
      "kind": "marks-signed",
      "params": {}
    },
    {
      "id": "FF-WORK-EMERGENCY",
      "kind": "emergencies-repaid",
      "params": {}
    },
    {
      "id": "FF-WORK-CEREMONY",
      "kind": "ceremony-reported",
      "params": {}
    },
    {
      "id": "FF-DELIVERY-APPETITE",
      "kind": "appetite-within-limit",
      "params": {}
    },
    {
      "id": "FF-DELIVERY-RESTATED",
      "kind": "section-restating-a-record",
      "params": {
        "over": "position_shapes",
        "sources": [
          "record_keeping"
        ],
        "list": "section_sources",
        "fields": [
          "id",
          "title"
        ],
        "because": "a record is the one home of what it states, and a hand-written line of a steering artifact that says the same thing again is a second home for it. Neither copy is wrong on the day it is written -- that is the danger: they stay internally correct while they drift, and from then on no reader can tell which one is lying, because each is right from where it stands.",
        "instead": "let this section be computed from the records, so the line comes back byte-identical and cannot go stale -- or, where what stands here is genuinely something no record owns, say the part only this artifact holds and drop the part a record already carries."
      }
    }
  ]
}
