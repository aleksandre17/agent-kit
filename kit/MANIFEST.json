{
  "schema_version": 1,
  "kit": {
    "id": "agent-kit",
    "version": "0.4.4"
  },
  "ships": {
    "lock": "kit.lock.json",
    "accounts": [
      {
        "id": "interpreter",
        "class": "interpreter",
        "root": "interpreters/",
        "suffix": ".py"
      },
      {
        "id": "readme",
        "class": "prose",
        "root": "README.md"
      },
      {
        "id": "diagnostics",
        "class": "declaration",
        "root": "diagnostics.json"
      },
      {
        "id": "version",
        "class": "declaration",
        "root": "VERSION"
      }
    ]
  },
  "classes": [
    "vendor",
    "binding",
    "projection",
    "ephemeral"
  ],
  "planes": [
    {
      "class": "vendor",
      "root": ".agents/kit",
      "unaccounted": "refuse"
    },
    {
      "class": "binding",
      "root": ".agents/project",
      "unaccounted": "refuse"
    },
    {
      "class": "projection",
      "root": ".agents/generated",
      "unaccounted": "refuse"
    },
    {
      "class": "ephemeral",
      "root": ".agents/runtime",
      "unaccounted": "report"
    }
  ],
  "capabilities": [
    {
      "id": "governance",
      "declaration": "capabilities/governance/capability.json",
      "never_disabled": true
    },
    {
      "id": "knowledge",
      "declaration": "capabilities/knowledge/capability.json"
    },
    {
      "id": "delivery",
      "declaration": "capabilities/delivery/capability.json"
    },
    {
      "id": "hygiene",
      "declaration": "capabilities/hygiene/capability.json"
    },
    {
      "id": "observability",
      "declaration": "capabilities/observability/capability.json"
    },
    {
      "id": "evaluation",
      "declaration": "capabilities/evaluation/capability.json"
    },
    {
      "id": "roles",
      "declaration": "capabilities/roles/capability.json"
    },
    {
      "id": "runtimes",
      "declaration": "capabilities/runtimes/capability.json"
    },
    {
      "id": "doctrine",
      "declaration": "capabilities/doctrine/capability.json"
    },
    {
      "id": "enforcement",
      "declaration": "capabilities/enforcement/capability.json"
    },
    {
      "id": "fitness",
      "declaration": "capabilities/fitness/capability.json"
    },
    {
      "id": "operating",
      "declaration": "capabilities/operating/capability.json"
    }
  ],
  "detectors": [
    "detectors/ci-workflows.json",
    "detectors/container-compose.json",
    "detectors/database-migrations.json",
    "detectors/declared-build-script.json",
    "detectors/declared-test-runner.json",
    "detectors/git-repository.json",
    "detectors/license-file.json"
  ],
  "schemas": {
    "manifest": "schemas/manifest.schema.json",
    "module-map": "schemas/module-map.schema.json",
    "lock": "schemas/lock.schema.json",
    "stewardship": "schemas/stewardship.schema.json",
    "estate": "schemas/estate.schema.json",
    "capability": "schemas/capability.schema.json",
    "detector": "schemas/detector.schema.json",
    "enforcers": "schemas/enforcers.schema.json",
    "project": "schemas/project.schema.json",
    "profile": "schemas/profile.schema.json",
    "lifecycle": "schemas/lifecycle.schema.json",
    "layout": "schemas/layout.schema.json",
    "record-keeping": "schemas/record-keeping.schema.json",
    "corpus-map": "schemas/corpus-map.schema.json",
    "front-matter": "schemas/front-matter.schema.json",
    "eviction": "schemas/eviction.schema.json",
    "position-shape": "schemas/position-shape.schema.json",
    "obligation-markers": "schemas/obligation-markers.schema.json",
    "card": "schemas/card.schema.json",
    "delivery-policy": "schemas/delivery-policy.schema.json",
    "work-classes": "schemas/work-classes.schema.json",
    "delivery-areas": "schemas/delivery-areas.schema.json",
    "review-record": "schemas/review-record.schema.json",
    "residence": "schemas/residence.schema.json",
    "boundary": "schemas/boundary.schema.json",
    "receipt": "schemas/receipt.schema.json",
    "observation": "schemas/observation.schema.json",
    "quality": "schemas/quality.schema.json",
    "consumption": "schemas/consumption.schema.json",
    "judgement": "schemas/judgement.schema.json",
    "archetype": "schemas/archetype.schema.json",
    "overlay": "schemas/overlay.schema.json",
    "runtime-class": "schemas/runtime-class.schema.json",
    "runtime": "schemas/runtime.schema.json",
    "runtime-surface": "schemas/runtime-surface.schema.json",
    "doctrine": "schemas/doctrine.schema.json",
    "cardinal": "schemas/cardinal.schema.json",
    "diagnostics": "schemas/diagnostics.schema.json",
    "stance": "schemas/stance.schema.json",
    "starter": "schemas/starter.schema.json",
    "hold": "schemas/hold.schema.json",
    "journal": "schemas/journal.schema.json",
    "provenance": "schemas/provenance.schema.json",
    "succession": "schemas/succession.schema.json",
    "migration-map": "schemas/migration-map.schema.json",
    "succession-act": "schemas/succession-act.schema.json",
    "edit-gate": "schemas/edit-gate.schema.json",
    "taken": "schemas/taken.schema.json",
    "law-scope": "schemas/law-scope.schema.json",
    "arrow": "schemas/arrow.schema.json",
    "dispatch-packet": "schemas/dispatch-packet.schema.json",
    "dispatch-adapter": "schemas/dispatch-adapter.schema.json",
    "workspace-provider": "schemas/workspace-provider.schema.json",
    "task": "schemas/task.schema.json",
    "lesson": "schemas/lesson.schema.json",
    "dispatch-return": "schemas/dispatch-return.schema.json",
    "route-table": "schemas/route-table.schema.json",
    "ground-reading": "schemas/ground-reading.schema.json",
    "runtime-observation": "schemas/runtime-observation.schema.json",
    "claim": "schemas/claim.schema.json",
    "arbitration": "schemas/arbitration.schema.json",
    "register": "schemas/register.schema.json",
    "register-kind": "schemas/register-kind.schema.json",
    "skills": "schemas/skills.schema.json",
    "mcp-servers": "schemas/mcp-servers.schema.json",
    "mcp-trust": "schemas/mcp-trust.schema.json",
    "context": "schemas/context.schema.json",
    "briefing-section": "schemas/briefing-section.schema.json",
    "task-classes": "schemas/task-classes.schema.json",
    "eval": "schemas/eval.schema.json",
    "destructive-commands": "schemas/destructive-commands.schema.json",
    "spawn-packets": "schemas/spawn-packets.schema.json",
    "change-record": "schemas/change-record.schema.json",
    "requirements": "schemas/requirements.schema.json",
    "execution-graph": "schemas/execution-graph.schema.json",
    "extension-points": "schemas/extension-points.schema.json",
    "extension-ledger": "schemas/extension-ledger.schema.json",
    "continuity-capsule": "schemas/continuity-capsule.schema.json",
    "conformance": "schemas/conformance.schema.json",
    "owners": "schemas/owners.schema.json",
    "message-rules": "schemas/message-rules.schema.json",
    "known-violations": "schemas/known-violations.schema.json"
  }
}
