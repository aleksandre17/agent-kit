{
  "schema_version": 1,
  "kit": {
    "id": "agent-kit",
    "version": "0.1.4"
  },
  "ships": {
    "lock": "kit.lock.json",
    "accounts": [
      { "id": "interpreter", "class": "interpreter", "root": "interpreters/", "suffix": ".py" },
      { "id": "fitness", "class": "declaration", "root": "fitness/", "suffix": ".json" },
      { "id": "readme", "class": "prose", "root": "README.md" }
    ]
  },
  "classes": [
    "vendor",
    "binding",
    "projection",
    "ephemeral"
  ],
  "planes": [
    { "class": "vendor", "root": ".agents/kit" },
    { "class": "binding", "root": ".agents/project" },
    { "class": "projection", "root": ".agents/generated" },
    { "class": "ephemeral", "root": ".agents/runtime" }
  ],
  "capabilities": [
    {
      "id": "governance",
      "declaration": "capabilities/governance/capability.json",
      "never_disabled": true
    },
    {
      "id": "knowledge",
      "declaration": "capabilities/knowledge/capability.json"
    },
    {
      "id": "delivery",
      "declaration": "capabilities/delivery/capability.json"
    },
    {
      "id": "hygiene",
      "declaration": "capabilities/hygiene/capability.json"
    },
    {
      "id": "observability",
      "declaration": "capabilities/observability/capability.json"
    },
    {
      "id": "evaluation",
      "declaration": "capabilities/evaluation/capability.json"
    },
    {
      "id": "roles",
      "declaration": "capabilities/roles/capability.json"
    },
    {
      "id": "runtimes",
      "declaration": "capabilities/runtimes/capability.json"
    }
  ],
  "detectors": [
    "detectors/git-repository.json",
    "detectors/node-workspace.json",
    "detectors/python-project.json"
  ],
  "schemas": {
    "manifest": "schemas/manifest.schema.json",
    "lock": "schemas/lock.schema.json",
    "capability": "schemas/capability.schema.json",
    "detector": "schemas/detector.schema.json",
    "project": "schemas/project.schema.json",
    "profile": "schemas/profile.schema.json",
    "lifecycle": "schemas/lifecycle.schema.json",
    "card": "schemas/card.schema.json",
    "delivery-policy": "schemas/delivery-policy.schema.json",
    "residence": "schemas/residence.schema.json",
    "boundary": "schemas/boundary.schema.json",
    "receipt": "schemas/receipt.schema.json",
    "observation": "schemas/observation.schema.json",
    "quality": "schemas/quality.schema.json",
    "judgement": "schemas/judgement.schema.json",
    "archetype": "schemas/archetype.schema.json",
    "overlay": "schemas/overlay.schema.json",
    "runtime-class": "schemas/runtime-class.schema.json",
    "runtime": "schemas/runtime.schema.json"
  }
}
