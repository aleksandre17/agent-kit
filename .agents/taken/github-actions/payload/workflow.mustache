# Generated. Do not edit. Served to the runtime {{runtime}} through the surface {{surface}} - kit {{kit_version}}.
# The one projection of this host's gates nobody skips with `--no-verify`: on every push and pull
# request the runner checks out the change and runs the kit THIS HOST CARRIES at {{vendor}} -- it
# never fetches one -- three times: `check` over the whole tree, `prove --full` (every command a MUST or
# an area names, on a clean runner that holds no proof record), and the one `judge` over the pushed or
# proposed diff against the edit gates this host declares. This is the AUTHORITATIVE gate -- the hooks are
# feedback a person may skip -- once branch protection requires it (ADR-025 amendment 5). No step holds
# policy of its own, and each fails CLOSED: a base that cannot be read, a diff that cannot be made or a Python that cannot be
# run refuses the run. Every other file in this directory is the owner's, and the kit never writes it.
name: kit gates
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  gates:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6.1.0, pinned by commit
        with:
          fetch-depth: 0
{{#referenced}}
          # This host references the kit in its own tree (a submodule): the runner needs it checked out.
          submodules: true
{{/referenced}}
      - name: check -- every gate this host declares, over the tree
        shell: sh
        run: |
          for candidate in python3 python py; do
            if "$candidate" -c "import sys" >/dev/null 2>&1; then
              exec "$candidate" "{{vendor}}/interpreters/cli.py" check --root . --surface {{surface}}
            fi
          done
          echo "kit gates: REFUSED -- no Python interpreter could be run, so nothing was checked" >&2
          exit 1
      - name: prove -- every command a MUST or an area names, on the commit checked out
        shell: sh
        run: |
          for candidate in python3 python py; do
            if "$candidate" -c "import sys" >/dev/null 2>&1; then
              exec "$candidate" "{{vendor}}/interpreters/cli.py" prove --root . --full --surface {{surface}}
            fi
          done
          echo "kit gates: REFUSED -- no Python interpreter could be run, so nothing was proved" >&2
          exit 1
      - name: judge -- the pushed or proposed change, against this host's edit gates
        shell: sh
        run: |
          python=""
          for candidate in python3 python py; do
            if "$candidate" -c "import sys" >/dev/null 2>&1; then python="$candidate"; break; fi
          done
          if [ -z "$python" ]; then
            echo "kit gates: REFUSED -- no Python interpreter could be run, so the change was not judged" >&2
            exit 1
          fi
          base=$("$python" -c 'import json, os; e = json.load(open(os.environ["GITHUB_EVENT_PATH"], encoding="utf-8")); print(((e.get("pull_request") or {}).get("base") or {}).get("sha") or e.get("before") or "")') || {
            echo "kit gates: REFUSED -- the event could not be read, so no base is known and nothing was judged" >&2
            exit 1
          }
          case "$base" in
            ""|*[!0]*) ;;
            *) base="" ;;
          esac
          if [ -z "$base" ]; then
            # No earlier commit (a new branch, a first push): everything the pushed tree holds is introduced.
            base=$(git hash-object -t tree /dev/null)
            echo "kit gates: the event names no earlier commit; the whole tree is judged as introduced"
          fi
          change=$(git -c core.quotepath=off diff --no-color --no-ext-diff --no-renames --unified=0 --src-prefix=a/ --dst-prefix=b/ "$base" HEAD) || {
            echo "kit gates: REFUSED -- the change from $base could not be read, so it was not judged" >&2
            exit 1
          }
          printf '%s\n' "$change" | "$python" "{{vendor}}/interpreters/cli.py" judge --root . --surface {{surface}} || exit 1
          # Whitespace errors the change introduces (trailing blanks, a conflict marker left behind):
          # git's own check over the same range (a first push has no range to check).
          [ "$base" = "$(git hash-object -t tree /dev/null)" ] || git diff --check "$base" HEAD || {
            echo "kit gates: REFUSED -- the change introduces whitespace errors or a conflict marker (git diff --check)" >&2
            exit 1
          }
          # Every pushed commit against its work-class floor (ADR-025): a commit hook skipped with
          # --no-verify, or a commit made where no hook runs, is weighed here, one commit at a time.
          # A new branch's first push weighs only what no other branch on the remote already carries:
          # those commits were weighed where they were made, and today's rules are not theirs.
          if [ "$base" = "$(git hash-object -t tree /dev/null)" ]; then
            "$python" "{{vendor}}/interpreters/cli.py" weigh --root . --head HEAD --each --published-as "origin/${GITHUB_REF_NAME}" || exit 1
          else
            "$python" "{{vendor}}/interpreters/cli.py" weigh --root . --base "$base" --head HEAD --each || exit 1
          fi
