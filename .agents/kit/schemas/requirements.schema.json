{
  "$id": "requirements",
  "title": "REQUIREMENTS -- the catalogue every change record states its applicability against",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "requirements"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "says"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "says": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
