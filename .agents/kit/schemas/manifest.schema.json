{
  "$id": "manifest",
  "title": "Kit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kit", "ships", "classes", "planes", "capabilities", "detectors", "schemas"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "ships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lock", "accounts"],
      "properties": {
        "lock": { "type": "string", "minLength": 1 },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "class", "root"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
              "class": { "type": "string", "minLength": 1 },
              "root": { "type": "string", "minLength": 1 },
              "suffix": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["vendor", "binding", "projection", "ephemeral"] }
    },
    "planes": {
      "description": "The kit's INSTALL planes: physical roots in a host tree, each with an install class and a rule for what is found there unaccounted. These are NOT the SEMANTIC planes of `governance/record-keeping.json#planes`, which say what a record is ABOUT and which no interpreter reads. One word, two referents, stated at both ends so that a reader who meets the bare word knows to ask which one (Cardinal III).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "root", "unaccounted"],
        "properties": {
          "class": { "type": "string", "enum": ["vendor", "binding", "projection", "ephemeral"] },
          "root": { "type": "string", "minLength": 1 },
          "unaccounted": { "type": "string", "enum": ["refuse", "report"] }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "declaration"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "declaration": { "type": "string", "minLength": 1 },
          "never_disabled": { "type": "boolean" }
        }
      }
    },
    "detectors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "schemas": { "type": "object" }
  }
}
