{
  "$id": "provenance",
  "title": "Provenance -- what a capability this kit did not issue means at each measured state, and how its signature is checked",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "digest",
    "statement",
    "states",
    "authenticity",
    "verifiers"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string"
    },
    "digest": {
      "description": "The content-digest form, named so a reader never guesses which one produced a pin.",
      "type": "string",
      "enum": [
        "h1"
      ]
    },
    "statement": {
      "description": "What a publisher signs: a template over {capability}, {version} and {digest}. Declared, so publisher and verifier read one text.",
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "disposition",
          "says"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "pinned",
              "withdrawn",
              "first-contact",
              "advanced",
              "drifted",
              "rolled-back"
            ]
          },
          "disposition": {
            "type": "string",
            "enum": [
              "hold",
              "carry",
              "door",
              "refuse"
            ]
          },
          "says": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authenticity": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "state",
          "standing",
          "says"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "signature-verified",
              "unsigned",
              "signature-missing",
              "unknown-verifier",
              "no-trust-root",
              "verifier-absent",
              "signature-refuted"
            ]
          },
          "standing": {
            "type": "string",
            "enum": [
              "established",
              "not established",
              "refused"
            ]
          },
          "says": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verifiers": {
      "description": "An OPEN registry of delegated verifiers. A new one is a row; the interpreter names none.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "argv",
          "namespace",
          "trust_root",
          "comment"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "namespace": {
            "type": "string",
            "minLength": 1
          },
          "trust_root": {
            "description": "Host-relative path of the file the HOST authors to say whom it trusts. The kit reads it and never writes it.",
            "type": "string",
            "minLength": 1
          },
          "comment": {
            "description": "The prefix that marks a line of the trust root as saying nothing. A trust root with no other line names nobody, which is an absence of trust -- never evidence against a signature.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
