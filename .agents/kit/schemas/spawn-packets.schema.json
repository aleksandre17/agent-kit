{
  "$id": "spawn-packets",
  "title": "SPAWN PACKETS -- the fields a sub-agent's brief carries, and its ceiling",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packets"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "summary": {
      "type": "string"
    },
    "packets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fields",
          "ceiling_tokens",
          "bytes_per_token"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "says"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "says": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "ceiling_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "bytes_per_token": {
            "type": "number",
            "minimum": 1
          },
          "fork": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "keys",
              "equals",
              "label"
            ],
            "properties": {
              "keys": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "equals": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
