{
  "schema_version": 1,
  "id": "governance",
  "version": "0.2.0",
  "summary": "Declares the four-class seam for a host: the reading, the declaration, the seeded law page, the pinned kit a host runs by itself with the lock it was given, and the index projection, plus the gates that hold them.",
  "doctrine": "capabilities/governance/payload/governance.md",
  "requires": [
    {
      "kind": "fact",
      "id": "vcs.git",
      "equals": true
    }
  ],
  "provides": [
    "governance"
  ],
  "conflicts": [],
  "declares": {
    "detectors": [
      "git-repository",
      "node-workspace",
      "python-project"
    ],
    "schemas": [
      "project",
      "profile",
      "stewardship",
      "estate",
      "stance",
      "provenance",
      "succession",
      "migration-map",
      "succession-act",
      "layout",
      "record-keeping",
      "position-shape",
      "taken",
      "law-scope"
    ]
  },
  "space": {
    "marker": ".gitkeep"
  },
  "documents": [
    {
      "id": "stewardship",
      "source": "capabilities/governance/stewardship.json",
      "validates": "stewardship"
    },
    {
      "id": "stances",
      "source": "capabilities/governance/stances.json",
      "validates": "stance"
    },
    {
      "id": "provenance",
      "source": "capabilities/governance/provenance.json",
      "validates": "provenance"
    },
    {
      "id": "succession",
      "source": "capabilities/governance/succession.json",
      "validates": "succession"
    },
    {
      "id": "host_layout",
      "source": "capabilities/governance/host-layout.json",
      "validates": "layout"
    },
    {
      "id": "record_keeping",
      "source": "capabilities/governance/record-keeping.json",
      "validates": "record-keeping"
    },
    {
      "id": "obligation_markers",
      "source": "capabilities/governance/obligation-markers.json",
      "validates": "obligation-markers"
    }
  ],
  "installs": [
    {
      "mode": "reading",
      "class": "binding",
      "target": ".agents/project/profile.json",
      "validates": "profile"
    },
    {
      "mode": "declaration",
      "class": "binding",
      "target": ".agents/project/project.json",
      "validates": "project"
    },
    {
      "mode": "estate",
      "class": "binding",
      "target": ".agents/project/estate.json",
      "validates": "estate"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/allowed_signers",
      "source": "seeds/allowed_signers"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/doctrine/laws.md",
      "source": "seeds/laws.md"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/doctrine/law-scopes.json",
      "source": "seeds/law-scopes.json",
      "validates": "law-scope",
      "reads_as": "law_scopes"
    },
    {
      "mode": "space",
      "class": "binding",
      "target": ".agents/project/doctrine/laws/"
    },
    {
      "mode": "space",
      "class": "binding",
      "target": ".agents/project/position/",
      "validates": "position-shape",
      "reads_as": "position_shapes"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/.gitignore",
      "source": "seeds/agents.gitignore"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/.gitattributes",
      "source": "seeds/agents.gitattributes"
    },
    {
      "mode": "pinned",
      "class": "vendor",
      "target": ".agents/kit/"
    },
    {
      "mode": "pinned-lock",
      "class": "binding",
      "target": ".agents/project/kit.lock.json",
      "validates": "lock"
    },
    {
      "mode": "taken",
      "class": "vendor",
      "target": ".agents/taken/",
      "declaration": "capability.json",
      "namespace": "capabilities/"
    },
    {
      "mode": "taken-declaration",
      "class": "binding",
      "target": ".agents/project/taken.json",
      "source": "seeds/taken.json",
      "validates": "taken"
    },
    {
      "mode": "projection",
      "class": "projection",
      "target": ".agents/generated/governance/CAPABILITIES.md",
      "source": "capabilities/governance/payload/INDEX.md.mustache"
    },
    {
      "mode": "seed",
      "class": "binding",
      "target": ".agents/project/succession/migration-map.json",
      "source": "capabilities/governance/payload/migration-map.json",
      "validates": "migration-map"
    },
    {
      "mode": "projection",
      "class": "projection",
      "target": ".agents/generated/INDEX.md",
      "source": "capabilities/governance/payload/RECORDS-MAP.md.mustache"
    }
  ],
  "relocations": [
    {
      "from": ".agents/project/laws.md",
      "to": ".agents/project/doctrine/laws.md",
      "decision": "ADR-021 decision 4"
    },
    {
      "from": ".agents/project/law-scopes.json",
      "to": ".agents/project/doctrine/law-scopes.json",
      "decision": "ADR-021 decision 4"
    },
    {
      "from": ".agents/project/laws/",
      "to": ".agents/project/doctrine/laws/",
      "decision": "ADR-021 decision 4",
      "referenced_by": [
        {
          "document": "law_scopes",
          "list": "scopes",
          "field": "page"
        }
      ]
    },
    {
      "from": ".agents/generated/governance/INDEX.md",
      "to": ".agents/generated/governance/CAPABILITIES.md",
      "decision": "ADR-021 decision 6"
    }
  ],
  "gates": [
    {
      "id": "FF-BINDING-SCHEMA-PROJECT",
      "kind": "schema-valid",
      "params": {
        "file": ".agents/project/project.json",
        "schema": "project"
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-BINDING-SCHEMA-PROFILE",
      "kind": "schema-valid",
      "params": {
        "file": ".agents/project/profile.json",
        "schema": "profile"
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-KIT-CLASS",
      "kind": "path-class-total",
      "params": {
        "root": ".agents"
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-KIT-PROJECTION",
      "kind": "projection-reproducible",
      "params": {},
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-READING-FRESH",
      "kind": "reading-current",
      "params": {
        "file": ".agents/project/profile.json"
      }
    },
    {
      "id": "FF-PROVENANCE-PINNED",
      "kind": "provenance-pinned",
      "params": {},
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-PLANE-WRITER",
      "kind": "plane-held-by-its-writer",
      "params": {
        "classes": ["vendor", "projection"],
        "writers": ["an-interactive-session"],
        "instead": {
          "vendor": "take a newer kit with `upgrade`, or fix the kit upstream; the pinned copy equals its lock.",
          "projection": "change the declaration the page is generated from, then `render`."
        }
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-KIT-PINNED",
      "kind": "pinned-kit-intact",
      "params": {
        "mode": "pinned",
        "lock_mode": "pinned-lock"
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-TAKEN-INTACT",
      "kind": "taken-intact",
      "params": {
        "plane_mode": "taken",
        "declaration_mode": "taken-declaration"
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-HOST-FLOOR",
      "kind": "layout-floor-present",
      "params": {
        "document": "host_layout",
        "side": "host"
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-RECORDS-DECLARED",
      "kind": "reference-declared-across",
      "params": {
        "over": "host_layout",
        "references": [
          {
            "id": "a-place-holding-an-undeclared-kind",
            "field": "entries",
            "each": "holds",
            "among": {
              "sources": [
                "record_keeping"
              ],
              "list": "kinds"
            },
            "because": "this place declares that it holds a kind of truth the record-keeping vocabulary does not name, so nothing can tell a document that belongs there from one that was misfiled -- the map reads as complete while this place has no declared contents.",
            "instead": "declared as a `kinds` row of governance's record-keeping vocabulary first, or the place names a kind already declared there.",
            "proves": {
              "entries": [
                {
                  "holds": "a-kind-nobody-declares"
                }
              ]
            },
            "admits": {
              "entries": [
                {
                  "holds": "decision"
                }
              ]
            }
          },
          {
            "id": "a-place-written-by-an-undeclared-writer",
            "field": "entries",
            "each": "writer",
            "among": {
              "sources": [
                "record_keeping"
              ],
              "list": "writers"
            },
            "because": "this place names a writer the record-keeping vocabulary does not declare, so no one is accountable for what lands there and no later gate can refuse a write by anyone else.",
            "instead": "declared as a `writers` row of the vocabulary first, or the place names an accountable writer already declared there.",
            "proves": {
              "entries": [
                {
                  "writer": "a-writer-nobody-declares"
                }
              ]
            },
            "admits": {
              "entries": [
                {
                  "writer": "renderer"
                }
              ]
            }
          },
          {
            "id": "a-place-with-an-undeclared-lifecycle",
            "field": "entries",
            "each": "lifecycle",
            "among": {
              "sources": [
                "record_keeping"
              ],
              "list": "lifecycles"
            },
            "because": "this place names a lifecycle the record-keeping vocabulary does not declare, so how its content ages and where it goes when it stops being current is unstated -- which is how a place silently becomes a graveyard.",
            "instead": "declared as a `lifecycles` row of the vocabulary first, or the place names a disposition already declared there.",
            "proves": {
              "entries": [
                {
                  "lifecycle": "a-lifecycle-nobody-declares"
                }
              ]
            },
            "admits": {
              "entries": [
                {
                  "lifecycle": "permanent"
                }
              ]
            }
          }
        ]
      },
      "stance": {
        "floor": "enforce"
      }
    },
    {
      "id": "FF-POSITION-SHAPE",
      "kind": "reference-declared-across",
      "params": {
        "over": "position_shapes",
        "references": [
          {
            "id": "a-section-cooling-to-an-undeclared-kind",
            "field": "sections",
            "each": "cools_to",
            "among": {
              "sources": [
                "record_keeping"
              ],
              "list": "kinds"
            },
            "because": "this section declares that its cold spans belong to a kind of record the vocabulary does not name, so the one passage that carries a span out of a bounded artifact has a destination nobody can resolve -- and a destination that resolves to nothing is how a preserved span becomes a graveyard with a label on it.",
            "instead": "declared as a `kinds` row of governance's record-keeping vocabulary first, or the section cools to a kind already declared there -- or it declares no `cools_to` at all, which says that nothing here cools and is a complete answer.",
            "proves": {
              "sections": [
                {
                  "cools_to": "a-kind-nobody-declares"
                }
              ]
            },
            "admits": {
              "sections": [
                {
                  "id": "a-section-that-does-not-cool"
                }
              ]
            }
          },
          {
            "id": "a-section-from-an-undeclared-source",
            "field": "sections",
            "each": "source",
            "among": {
              "sources": [
                "record_keeping"
              ],
              "list": "section_sources"
            },
            "because": "this section says its content comes from somewhere the vocabulary does not name, so nothing can tell whether a hand may legitimately write here -- and the difference between an authored line and a projected one is the difference between destroying a truth and regenerating a copy.",
            "instead": "declared as a `section_sources` row of the vocabulary first, or the section names a provenance already declared there.",
            "proves": {
              "sections": [
                {
                  "source": "a-source-nobody-declares"
                }
              ]
            },
            "admits": {
              "sections": [
                {
                  "source": "authored"
                }
              ]
            }
          },
          {
            "id": "a-section-written-for-an-undeclared-audience",
            "field": "sections",
            "each": "audience",
            "among": {
              "sources": [
                "record_keeping"
              ],
              "list": "audiences"
            },
            "because": "this section names a reader the vocabulary does not declare, so its audience is legible to its author and to nobody else -- and a section whose reader cannot be resolved is projected by guess, to everyone or to no one.",
            "instead": "declared as an `audiences` row of the vocabulary first, or the section names a reader already declared there.",
            "proves": {
              "sections": [
                {
                  "audience": "a-reader-nobody-declares"
                }
              ]
            },
            "admits": {
              "sections": [
                {
                  "audience": "steward"
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
